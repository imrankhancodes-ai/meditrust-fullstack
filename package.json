{
  "name": "meditrust",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "Imran Khan",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "predev": "npm --prefix client install",
    "server": "node --watch server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "node seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
